# Variables de entorno requeridas en Azure App Service
# (Configuración → Variables de entorno). No usar este archivo en producción,
# es solo referencia de qué nombres y formato esperar. Nunca subir a git
# un archivo .env real con valores verdaderos.

# --- App Registration en Entra ID (compartida por Dynamics y Graph) ---
D365_TENANT_ID=00000000-0000-0000-0000-000000000000
D365_CLIENT_ID=00000000-0000-0000-0000-000000000000
D365_CLIENT_SECRET=tu-client-secret-aqui

# --- Dynamics ---
# URL del ambiente que debe recibir los leads comerciales.
# IMPORTANTE: NO usar aquí el ambiente demo de un cliente (ej. el que se
# use para simular APIs en una propuesta) — debe ser el CRM comercial real.
D365_URL=https://tudominio.crm2.dynamics.com

# --- Correo (Microsoft Graph sendMail) ---
# MAIL_FROM debe ser un buzón real con licencia Exchange Online, y el App
# Registration debe tener el permiso de APLICACIÓN "Mail.Send" (Microsoft
# Graph) con consentimiento de administrador otorgado.
MAIL_FROM=notificaciones@w-it.cl
MAIL_TO=ventas@regulatec.cl

# --- CORS y seguridad ---
ALLOWED_ORIGINS=https://www.regulatec.cl,http://localhost:8080
RECAPTCHA_SECRET=tu-recaptcha-secret-aqui

# --- Build ---
SCM_DO_BUILD_DURING_DEPLOYMENT=true
